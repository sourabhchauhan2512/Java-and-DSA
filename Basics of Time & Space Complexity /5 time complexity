import java.util.*;

public class main {
    public static void main(String args[]) {
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int m = sc.nextInt();

        for(int i=0; i<n; i++) { 
            System.out.println("hello"); 
            }
        for(int j=0; j<m; j++) {
            System.out.println("hello");
        }
    }
}

// time complexity = O(n+m)
