import java.util.*;

public class Bits {
    public static void main(String args[]) {
        Scanner sc = new Scanner(System.in);

        System.out.println("Enter a number");
        int n = sc.nextInt();

        System.out.println("Enter Position");
        int pos = sc.nextInt();

        n = n ^ (1 << pos);

        System.out.println("Number after toggling: " + n);
    }
}
